# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=password
DB_NAME=contribution_db
DB_POOL_SIZE=20

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Throttle (rate limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
